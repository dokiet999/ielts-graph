# Copy to .env.local (not committed) and adjust.

# Base URL of the backend API. Vite proxies /api to http://localhost:8080 in dev.
VITE_API_URL=/api

# true (default): run against the MSW mock API. false: use the real Spring Boot backend.
VITE_USE_MOCK=true

# Demo mode for the real backend (it has no login yet, only HTTP Basic).
# When VITE_DEMO_USER is set the login page is skipped and every request sends
# "Authorization: Basic base64(user:password)". Local demos only: never deploy these values.
# Example for the seeded demo learner (password from migration V4):
# VITE_USE_MOCK=false
# VITE_DEMO_USER=student_enrolled
# VITE_DEMO_PASSWORD=Demo@123
# VITE_DEMO_FULLNAME=Enrolled Student
