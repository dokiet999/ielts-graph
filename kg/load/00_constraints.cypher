CREATE CONSTRAINT skill_id IF NOT EXISTS FOR (n:Skill) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT criterion_id IF NOT EXISTS FOR (n:Criterion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT subskill_id IF NOT EXISTS FOR (n:SubSkill) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT errortype_id IF NOT EXISTS FOR (n:ErrorType) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT questiontype_id IF NOT EXISTS FOR (n:QuestionType) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT bandlevel_id IF NOT EXISTS FOR (n:BandLevel) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT resource_id IF NOT EXISTS FOR (n:Resource) REQUIRE n.id IS UNIQUE;
